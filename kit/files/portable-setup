#!/usr/bin/env bash
# Runs inside the sandbox (installed by the kit overlay as /usr/local/bin/portable-setup).
#
#   portable-setup install    lifecycle install hook, as root, when the sandbox is created and again
#                             each time portable updates its kit in place (so it must be rerunnable):
#                             clones PORTABLE_CLAUDE_CONFIG_REPO, links it into ~/.claude with the
#                             repo's own install.sh, and points git at gh for GitHub credentials
#   portable-setup update     lifecycle startup hook, as root, at every boot: fetches the repo and,
#                             when GitHub has new commits, resets the clone to them and relinks
#   portable-setup permissions  lifecycle startup hook, as root, at every boot: drops the
#                             bypassPermissions default Docker's workload writes into ~/.claude/settings.json,
#                             so Claude asks unless a mode is passed (portable claude does)
#   portable-setup config     from the host through `sbx exec`, as root, with the skills and rules to
#                             leave off on stdin (one per line): records them, then updates and relinks
#   portable-setup repo       from the host through `sbx exec`, as root, with the configuration repo's
#                             URL on stdin (blank for none): records it, re-clones when it changed and
#                             relinks, or removes the clone and its links
#   portable-setup aws        from the host through `sbx exec`, as root, with `export AWS_...`
#                             lines on stdin: makes them the sandbox's AWS credentials
#   portable-setup ports      from the host's agent through `sbx exec`, as root, with `SANDBOX MAC` port
#                             pairs on stdin: records where ports are reachable on the Mac
#
# The clone is root's and read-only to the agent, so a session can't edit it and leave changes that
# block later updates: changes go through the repo on GitHub (see claude-instructions.md). Failures
# with the repo only warn, so the sandbox still works without it.
set -uo pipefail

agent_user=agent
agent_home="${PORTABLE_AGENT_HOME:-/home/$agent_user}"
config_dir=$agent_home/claude-configuration
state_dir=$agent_home/.claude
persistent="${PORTABLE_PERSISTENT_FILE:-/etc/sandbox-persistent.sh}"
# Skills and rules to leave off, as set on the environment's page. Kept in the sandbox so later boots
# use it; until the page has set one, the list the sandbox was created with applies.
disable_file="${PORTABLE_DISABLE_FILE:-/etc/portable/claude-config-disable}"
# The configuration repo's URL, as set on the environment's page, the same way: once the page has set
# one (even blank), it wins over the URL the sandbox was created with (PORTABLE_CLAUDE_CONFIG_REPO).
repo_file="${PORTABLE_REPO_FILE:-/etc/portable/claude-config-repo}"

warn() { echo "portable: $*" >&2; }

config_repo() {
  if [ -f "$repo_file" ]; then cat "$repo_file"; else printf '%s' "${PORTABLE_CLAUDE_CONFIG_REPO:-}"; fi
}

# Removes the links into the clone that the repo's install.sh made in ~/.claude, before the clone
# goes or is replaced by another repo's.
unlink_config() {
  [ -d "$state_dir" ] && find "$state_dir" -maxdepth 3 -type l -lname "$config_dir/*" -delete 2>/dev/null
  return 0
}

disabled_names() {
  if [ -f "$disable_file" ]; then tr '\n' ' ' < "$disable_file" | sed 's/ *$//'; else echo "${PORTABLE_CLAUDE_CONFIG_DISABLE:-}"; fi
}

# git on the clone as root, with root's HOME, so gh (the credential helper) keeps its files out of
# the agent's home. Hooks only see the env vars the kit declares, so GH_TOKEN is passed on explicitly.
config_git() { HOME=/root GH_TOKEN="${GH_TOKEN:-}" git -C "$config_dir" "$@"; }

# Prints a CLAUDE.md or rules file (path relative to the clone, read from stdin) without the lines that
# name one of the skills or rules in $2, e.g. the docker-ports workflow step and rule bullet, and with
# CLAUDE.md's numbered list renumbered. This is how the sandbox's copy leaves disabled ones out.
filter_disabled() {
  local name script=""
  for name in $2; do script="$script/\`$name\`/d;"; done
  if [ "$1" = global/CLAUDE.md ]; then
    sed "$script" | awk '/^[0-9]+\. / { sub(/^[0-9]+/, ++n) } !/^[0-9]+\. / { n = 0 } 1'
  else
    sed "$script"
  fi
}

# Copies files changed or added in the clone, other than by portable's filtering, to the agent's
# backups before an update replaces them. Read-only clones shouldn't have any; just in case.
save_leftovers() {
  local filtered file files="" backup
  filtered="$(cat "$config_dir/.git/portable-filtered" 2>/dev/null)"
  while IFS= read -r file; do
    case "$file" in
      global/CLAUDE.md | rules/*.md)
        config_git show "HEAD:$file" 2>/dev/null | filter_disabled "$file" "$filtered" \
          | cmp -s - "$config_dir/$file" && continue ;;
    esac
    files="$files$file"$'\n'
  done < <(config_git ls-files --modified --others --exclude-standard)
  [ -n "$files" ] || return 0

  backup="$state_dir/backups/claude-configuration-leftovers/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$backup"
  while IFS= read -r file; do
    (cd "$config_dir" && cp --parents "$file" "$backup" 2>/dev/null)
  done <<< "${files%$'\n'}"
  chown -R "$agent_user:$agent_user" "$state_dir/backups"
  warn "$config_dir had changes made in it, which this update replaces. Saved them to $backup:"
  printf '%s' "$files" | sed 's/^/  /' >&2
}

# Rewrites the clone's CLAUDE.md and rules without the skills and rules in $1, from the committed
# files, and records the list in the marker. Edits go to the clone's files, which ~/.claude links
# to, so the links stay intact.
apply_filter() {
  local disabled="$1" marker="$config_dir/.git/portable-filtered" path
  config_git checkout --quiet -- global/CLAUDE.md rules 2>/dev/null
  for path in "$config_dir/global/CLAUDE.md" "$config_dir"/rules/*.md; do
    [ -f "$path" ] || continue
    filter_disabled "${path#"$config_dir/"}" "$disabled" < "$path" > "$path.tmp" && mv "$path.tmp" "$path"
  done
  echo "$disabled" > "$marker"
  chown -R root:root "$config_dir"
  chmod -R a+rX,go-w "$config_dir"
}

# Clones or updates the configuration repo (as root). Prints "changed" when files were replaced.
sync_clone() {
  local repo disabled
  repo="$(config_repo)"
  disabled="$(disabled_names)"
  local marker="$config_dir/.git/portable-filtered" refilter=""
  [ -n "$repo" ] || return 1

  # Another repo than the clone's (changed on the page): start over with the new one.
  if [ -d "$config_dir/.git" ] && [ "$(config_git config --get remote.origin.url 2>/dev/null)" != "$repo" ]; then
    warn "the configuration repo changed to $repo; replacing the clone"
    unlink_config
    rm -rf "$config_dir"
  fi
  if [ ! -d "$config_dir/.git" ]; then
    warn "cloning $repo"
    rm -rf "$config_dir"
    if ! HOME=/root GH_TOKEN="${GH_TOKEN:-}" git clone --quiet "$repo" "$config_dir" >&2; then
      warn "couldn't clone $repo (is a GitHub token stored, and does it include this repo?); continuing without it"
      return 1
    fi
    refilter=1
  elif ! HOME=/root GH_TOKEN="${GH_TOKEN:-}" timeout 20 git -C "$config_dir" fetch --quiet >/dev/null 2>&1; then
    warn "couldn't update $config_dir (offline?); using the copy already there"
  elif [ "$(config_git rev-parse HEAD)" != "$(config_git rev-parse '@{u}')" ]; then
    # Only touch the files when there's something new, so sessions already running never see them
    # half-updated. A reset rather than a merge: the clone only ever mirrors the remote.
    save_leftovers
    config_git reset --quiet --hard '@{u}' && config_git clean -fdq
    refilter=1
  fi
  if [ "$(cat "$marker" 2>/dev/null)" != "$disabled" ]; then
    refilter=1
  fi
  [ -z "$refilter" ] || apply_filter "$disabled"
  [ -n "$refilter" ] && echo changed
  return 0
}

# Links the clone into ~/.claude with the repo's own install.sh, as the agent. install.sh keeps
# disabled names in personal-disabled, written from the env var so names removed from .env come
# back on. CLAUDE_CONFIGURATION_DIR makes it treat this clone as the installed copy.
link_config() {
  [ -d "$config_dir/.git" ] || return 0
  local name
  mkdir -p "$state_dir"
  for name in $(disabled_names); do echo "$name"; done > "$state_dir/personal-disabled"
  chown "$agent_user:$agent_user" "$state_dir" "$state_dir/personal-disabled"
  runuser -u "$agent_user" -- env HOME="$agent_home" CLAUDE_CONFIG_DIR="$state_dir" \
      CLAUDE_CONFIGURATION_DIR="$config_dir" bash "$config_dir/install.sh" 2>&1 \
    | grep -v '^Already up to date' >&2 || true
}

cmd_install() {
  # git over HTTPS to GitHub gets its credentials from gh, which reads GH_TOKEN (the proxy-managed
  # placeholder; the proxy swaps in the real token). Same wiring as Docker's github-clone kit.
  git config --system credential.https://github.com.helper '!gh auth git-credential'
  git config --system credential.https://gist.github.com.helper '!gh auth git-credential'
  git config --system --get-all safe.directory 2>/dev/null | grep -qxF "$config_dir" \
    || git config --system --add safe.directory "$config_dir"
  if [ -z "$(config_repo)" ]; then
    warn "no Claude configuration repo set (claudeConfigRepo); skipping"
    return 0
  fi
  # A failed clone only warns (sync_clone says why): the sandbox works without the repo, and the
  # startup hook tries again at the next boot.
  sync_clone >/dev/null && link_config
  return 0
}

cmd_update() {
  [ -n "$(config_repo)" ] || return 0
  local result
  result="$(sync_clone)" || return 0
  # Relink when files changed, or when the install never happened (e.g. the repo was unreachable then).
  if [ "$result" = changed ] || [ "$(readlink "$state_dir/CLAUDE.md" 2>/dev/null)" != "$config_dir/global/CLAUDE.md" ]; then
    link_config
  fi
}

# Records the skills and rules to leave off (names on stdin, one per line), then refilters and
# relinks the configuration repo so new Claude sessions use the list. No fetch: the clone already
# there is used, so a checkbox on the page doesn't wait on GitHub; the startup hook updates it.
cmd_config() {
  local name tmp
  tmp="$(mktemp)"
  while IFS= read -r name; do
    case "$name" in '' ) continue ;; *[!A-Za-z0-9_.-]*) warn "skipping '$name' (not a skill or rule name)"; continue ;; esac
    echo "$name"
  done > "$tmp"
  mkdir -p "$(dirname "$disable_file")" && install -m 644 "$tmp" "$disable_file" && rm -f "$tmp"
  [ -n "$(config_repo)" ] || return 0
  if [ -d "$config_dir/.git" ]; then
    apply_filter "$(disabled_names)"
  else
    sync_clone >/dev/null || return 0
  fi
  link_config
}

# Records the configuration repo's URL (one line on stdin; blank for none) and brings the clone in
# line: re-cloned and relinked when the URL changed, removed with its links when it's blank. Fails
# when the new repo can't be cloned, so the page can say so.
cmd_repo() {
  local repo=""
  IFS= read -r repo || true
  case "$repo" in
    '') ;;
    https://*) case "$repo" in *[[:space:]\'\"\`\$]*) warn "not a repo URL: $repo"; return 2 ;; esac ;;
    *) warn "the configuration repo must be an HTTPS git URL: $repo"; return 2 ;;
  esac
  mkdir -p "$(dirname "$repo_file")" && printf '%s' "$repo" > "$repo_file" && chmod 644 "$repo_file"
  if [ -z "$repo" ]; then
    unlink_config
    rm -rf "$config_dir"
    return 0
  fi
  sync_clone >/dev/null || return 1
  link_config
}

# Replaces portable's block in /etc/sandbox-persistent.sh with the `export AWS_...` lines on stdin
# (only names starting with AWS_ are taken). sbx reads that file into every new session, so fresh
# STS credentials reach the next `portable` without recreating the sandbox. Other content stays.
cmd_aws() {
  local lines line name begin='# portable-aws begin' end='# portable-aws end' tmp
  lines=""
  while IFS= read -r line; do
    name="${line#export }"; name="${name%%=*}"
    case "$name" in AWS_[A-Z_]*) lines="$lines$line"$'\n' ;; esac
  done
  tmp="$(mktemp)"
  { [ -f "$persistent" ] && awk -v b="$begin" -v e="$end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$persistent"
    if [ -n "$lines" ]; then printf '%s\n%s%s\n' "$begin" "$lines" "$end"; fi
  } > "$tmp"
  install -m 644 "$tmp" "$persistent" && rm -f "$tmp"
}

# Writes the ports portable forwards to the Mac (`SANDBOX MAC` per line on stdin) to
# /etc/portable/ports, which the start skill and CLAUDE.md read to give the user Mac URLs. Only
# pairs of numbers are taken; the whole file is replaced, so a port that's gone disappears.
cmd_ports() {
  local sandbox mac tmp
  tmp="$(mktemp)"
  {
    echo "# Ports forwarded to the Mac by portable: sandbox port, then the Mac port (http://localhost:<Mac port>)."
    echo "# Rewritten by portable within seconds of a container publishing or dropping a port."
    while read -r sandbox mac; do
      case "$sandbox:$mac" in *[!0-9:]* | :* | *:) continue ;; esac
      echo "$sandbox $mac"
    done
  } > "$tmp"
  mkdir -p /etc/portable && install -m 644 "$tmp" /etc/portable/ports && rm -f "$tmp"
}

# Docker's Claude Code workload sets permissions.defaultMode to bypassPermissions in the agent's
# settings, which applies to any session started without a --permission-mode flag. Removes just that
# default (other settings stay), so the mode falls back to asking. The flags still work.
cmd_permissions() {
  local file="$state_dir/settings.json" tmp
  [ -f "$file" ] || return 0
  [ "$(jq -r '.permissions.defaultMode // empty' "$file" 2>/dev/null)" = bypassPermissions ] || return 0
  tmp="$(mktemp)"
  if jq 'del(.permissions.defaultMode) | if .permissions == {} then del(.permissions) else . end' "$file" > "$tmp"; then
    cat "$tmp" > "$file"   # in place, keeping the agent's ownership and mode
  else
    warn "couldn't change $file"
  fi
  rm -f "$tmp"
}

case "${1:-}" in
  permissions) cmd_permissions ;;
  install) cmd_install ;;
  update) cmd_update ;;
  config) cmd_config ;;
  aws) cmd_aws ;;
  ports) cmd_ports ;;
  repo) cmd_repo ;;
  *) echo "usage: portable-setup install|update|config|aws|ports|repo|permissions" >&2; exit 2 ;;
esac
