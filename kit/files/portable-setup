#!/usr/bin/env bash
# Runs inside the sandbox (installed by the kit overlay as /usr/local/bin/portable-setup).
#
#   portable-setup install    lifecycle install hook, as root, when the sandbox is created and again
#                             each time portable updates its kit in place (so it must be rerunnable):
#                             clones PORTABLE_CLAUDE_CONFIG_REPO, links it into ~/.claude with the
#                             repo's own install.sh, and points git at gh for GitHub credentials
#   portable-setup update     lifecycle startup hook, as root, at every boot: fetches the repo and,
#                             when GitHub has new commits, resets the clone to them and relinks
#   portable-setup config     from the host through `sbx exec`, as root, with the skills and rules to
#                             leave off on stdin (one per line): records them, then updates and relinks
#   portable-setup repo       from the host through `sbx exec`, as root, with the configuration repo's
#                             URL on stdin (blank for none): records it, re-clones when it changed and
#                             relinks, or removes the clone and its links
#   portable-setup aws        from the host through `sbx exec`, as root, with `export AWS_...`
#                             lines on stdin: makes them the sandbox's AWS credentials
#   portable-setup ports      from the host's agent through `sbx exec`, as root, with `SANDBOX MAC` port
#                             pairs on stdin: records where ports are reachable on the Mac
#   portable-setup doctor     from `portable doctor` through `sbx exec`, as the agent: checks the
#                             sandbox (tools, credentials, Claude configuration, Docker, network)
#
# The clone is root's and read-only to the agent, so a session can't edit it and leave changes that
# block later updates: changes go through the repo on GitHub (see claude-instructions.md). Failures
# with the repo only warn, so the sandbox still works without it.
set -uo pipefail

agent_user=agent
agent_home="${PORTABLE_AGENT_HOME:-/home/$agent_user}"
config_dir=$agent_home/claude-configuration
state_dir=$agent_home/.claude
persistent="${PORTABLE_PERSISTENT_FILE:-/etc/sandbox-persistent.sh}"
# Skills and rules to leave off, as set on the environment's page. Kept in the sandbox so later boots
# use it; until the page has set one, the list the sandbox was created with applies.
disable_file="${PORTABLE_DISABLE_FILE:-/etc/portable/claude-config-disable}"
# The configuration repo's URL, as set on the environment's page, the same way: once the page has set
# one (even blank), it wins over the URL the sandbox was created with (PORTABLE_CLAUDE_CONFIG_REPO).
repo_file="${PORTABLE_REPO_FILE:-/etc/portable/claude-config-repo}"

warn() { echo "portable: $*" >&2; }

# Docker's Claude Code workload writes permissions.defaultMode "bypassPermissions" into the agent's
# settings, so a `claude` typed in a portable shell would start with no prompts. Set it back to
# "default" (only that value: a mode the user chose stays). Without the setting or a flag, bypass
# isn't offered at all (not even with Shift+Tab); `claude --dangerously-skip-permissions` starts in
# it on purpose. Runs at install and every boot, in case something writes the setting again.
claude_defaults() {
  local settings="$state_dir/settings.json" tmp
  if [ -f "$settings" ] && [ ! -L "$settings" ] \
      && [ "$(jq -r '.permissions.defaultMode? // empty' "$settings" 2>/dev/null)" = bypassPermissions ]; then
    tmp="$(mktemp)"
    # Written back with cat so the file keeps its owner and mode.
    if jq '.permissions.defaultMode = "default"' "$settings" > "$tmp"; then
      cat "$tmp" > "$settings"
    else
      warn "couldn't change Claude's default permission mode in $settings"
    fi
    rm -f "$tmp"
  fi
  return 0
}

config_repo() {
  if [ -f "$repo_file" ]; then cat "$repo_file"; else printf '%s' "${PORTABLE_CLAUDE_CONFIG_REPO:-}"; fi
}

# Removes the links into the clone that the repo's install.sh made in ~/.claude, before the clone
# goes or is replaced by another repo's.
unlink_config() {
  [ -d "$state_dir" ] && find "$state_dir" -maxdepth 3 -type l -lname "$config_dir/*" -delete 2>/dev/null
  return 0
}

disabled_names() {
  if [ -f "$disable_file" ]; then tr '\n' ' ' < "$disable_file" | sed 's/ *$//'; else echo "${PORTABLE_CLAUDE_CONFIG_DISABLE:-}"; fi
}

# git on the clone as root, with root's HOME, so gh (the credential helper) keeps its files out of
# the agent's home. Hooks only see the env vars the kit declares, so GH_TOKEN is passed on explicitly.
config_git() { HOME=/root GH_TOKEN="${GH_TOKEN:-}" git -C "$config_dir" "$@"; }

# Prints a CLAUDE.md or rules file (path relative to the clone, read from stdin) without the lines that
# name one of the skills or rules in $2, e.g. the docker-ports workflow step and rule bullet, and with
# CLAUDE.md's numbered list renumbered. This is how the sandbox's copy leaves disabled ones out.
filter_disabled() {
  local name script=""
  for name in $2; do script="$script/\`$name\`/d;"; done
  if [ "$1" = global/CLAUDE.md ]; then
    sed "$script" | awk '/^[0-9]+\. / { sub(/^[0-9]+/, ++n) } !/^[0-9]+\. / { n = 0 } 1'
  else
    sed "$script"
  fi
}

# Copies files changed or added in the clone, other than by portable's filtering, to the agent's
# backups before an update replaces them. Read-only clones shouldn't have any; just in case.
save_leftovers() {
  local filtered file files="" backup
  filtered="$(cat "$config_dir/.git/portable-filtered" 2>/dev/null)"
  while IFS= read -r file; do
    case "$file" in
      global/CLAUDE.md | rules/*.md)
        config_git show "HEAD:$file" 2>/dev/null | filter_disabled "$file" "$filtered" \
          | cmp -s - "$config_dir/$file" && continue ;;
    esac
    files="$files$file"$'\n'
  done < <(config_git ls-files --modified --others --exclude-standard)
  [ -n "$files" ] || return 0

  backup="$state_dir/backups/claude-configuration-leftovers/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$backup"
  while IFS= read -r file; do
    (cd "$config_dir" && cp --parents "$file" "$backup" 2>/dev/null)
  done <<< "${files%$'\n'}"
  chown -R "$agent_user:$agent_user" "$state_dir/backups"
  warn "$config_dir had changes made in it, which this update replaces. Saved them to $backup:"
  printf '%s' "$files" | sed 's/^/  /' >&2
}

# Rewrites the clone's CLAUDE.md and rules without the skills and rules in $1, from the committed
# files, and records the list in the marker. Edits go to the clone's files, which ~/.claude links
# to, so the links stay intact.
apply_filter() {
  local disabled="$1" marker="$config_dir/.git/portable-filtered" path
  config_git checkout --quiet -- global/CLAUDE.md rules 2>/dev/null
  for path in "$config_dir/global/CLAUDE.md" "$config_dir"/rules/*.md; do
    [ -f "$path" ] || continue
    filter_disabled "${path#"$config_dir/"}" "$disabled" < "$path" > "$path.tmp" && mv "$path.tmp" "$path"
  done
  echo "$disabled" > "$marker"
  chown -R root:root "$config_dir"
  chmod -R a+rX,go-w "$config_dir"
}

# Clones or updates the configuration repo (as root). Prints "changed" when files were replaced.
sync_clone() {
  local repo disabled
  repo="$(config_repo)"
  disabled="$(disabled_names)"
  local marker="$config_dir/.git/portable-filtered" refilter=""
  [ -n "$repo" ] || return 1

  # Another repo than the clone's (changed on the page): start over with the new one.
  if [ -d "$config_dir/.git" ] && [ "$(config_git config --get remote.origin.url 2>/dev/null)" != "$repo" ]; then
    warn "the configuration repo changed to $repo; replacing the clone"
    unlink_config
    rm -rf "$config_dir"
  fi
  if [ ! -d "$config_dir/.git" ]; then
    warn "cloning $repo"
    rm -rf "$config_dir"
    if ! HOME=/root GH_TOKEN="${GH_TOKEN:-}" git clone --quiet "$repo" "$config_dir" >&2; then
      warn "couldn't clone $repo (is a GitHub token stored, and does it include this repo?); continuing without it"
      return 1
    fi
    refilter=1
  elif ! HOME=/root GH_TOKEN="${GH_TOKEN:-}" timeout 20 git -C "$config_dir" fetch --quiet >/dev/null 2>&1; then
    warn "couldn't update $config_dir (offline?); using the copy already there"
  elif [ "$(config_git rev-parse HEAD)" != "$(config_git rev-parse '@{u}')" ]; then
    # Only touch the files when there's something new, so sessions already running never see them
    # half-updated. A reset rather than a merge: the clone only ever mirrors the remote.
    save_leftovers
    config_git reset --quiet --hard '@{u}' && config_git clean -fdq
    refilter=1
  fi
  if [ "$(cat "$marker" 2>/dev/null)" != "$disabled" ]; then
    refilter=1
  fi
  [ -z "$refilter" ] || apply_filter "$disabled"
  [ -n "$refilter" ] && echo changed
  return 0
}

# Links the clone into ~/.claude with the repo's own install.sh, as the agent. install.sh keeps
# disabled names in personal-disabled, written from the env var so names removed from .env come
# back on. CLAUDE_CONFIGURATION_DIR makes it treat this clone as the installed copy.
link_config() {
  [ -d "$config_dir/.git" ] || return 0
  local name
  mkdir -p "$state_dir"
  for name in $(disabled_names); do echo "$name"; done > "$state_dir/personal-disabled"
  chown "$agent_user:$agent_user" "$state_dir" "$state_dir/personal-disabled"
  runuser -u "$agent_user" -- env HOME="$agent_home" CLAUDE_CONFIG_DIR="$state_dir" \
      CLAUDE_CONFIGURATION_DIR="$config_dir" bash "$config_dir/install.sh" 2>&1 \
    | grep -v '^Already up to date' >&2 || true
}

cmd_install() {
  # git over HTTPS to GitHub gets its credentials from gh, which reads GH_TOKEN (the proxy-managed
  # placeholder; the proxy swaps in the real token). Same wiring as Docker's github-clone kit.
  git config --system credential.https://github.com.helper '!gh auth git-credential'
  git config --system credential.https://gist.github.com.helper '!gh auth git-credential'
  git config --system --get-all safe.directory 2>/dev/null | grep -qxF "$config_dir" \
    || git config --system --add safe.directory "$config_dir"
  claude_defaults
  if [ -z "$(config_repo)" ]; then
    warn "no Claude configuration repo set (claudeConfigRepo); skipping"
    return 0
  fi
  # A failed clone only warns (sync_clone says why): the sandbox works without the repo, and the
  # startup hook tries again at the next boot.
  sync_clone >/dev/null && link_config
  return 0
}

cmd_update() {
  claude_defaults
  [ -n "$(config_repo)" ] || return 0
  local result
  result="$(sync_clone)" || return 0
  # Relink when files changed, or when the install never happened (e.g. the repo was unreachable then).
  if [ "$result" = changed ] || [ "$(readlink "$state_dir/CLAUDE.md" 2>/dev/null)" != "$config_dir/global/CLAUDE.md" ]; then
    link_config
  fi
}

# Records the skills and rules to leave off (names on stdin, one per line), then refilters and
# relinks the configuration repo so new Claude sessions use the list. No fetch: the clone already
# there is used, so a checkbox on the page doesn't wait on GitHub; the startup hook updates it.
cmd_config() {
  local name tmp
  tmp="$(mktemp)"
  while IFS= read -r name; do
    case "$name" in '' ) continue ;; *[!A-Za-z0-9_.-]*) warn "skipping '$name' (not a skill or rule name)"; continue ;; esac
    echo "$name"
  done > "$tmp"
  mkdir -p "$(dirname "$disable_file")" && install -m 644 "$tmp" "$disable_file" && rm -f "$tmp"
  [ -n "$(config_repo)" ] || return 0
  if [ -d "$config_dir/.git" ]; then
    apply_filter "$(disabled_names)"
  else
    sync_clone >/dev/null || return 0
  fi
  link_config
}

# Records the configuration repo's URL (one line on stdin; blank for none) and brings the clone in
# line: re-cloned and relinked when the URL changed, removed with its links when it's blank. Fails
# when the new repo can't be cloned, so the page can say so.
cmd_repo() {
  local repo=""
  IFS= read -r repo || true
  case "$repo" in
    '') ;;
    https://*) case "$repo" in *[[:space:]\'\"\`\$]*) warn "not a repo URL: $repo"; return 2 ;; esac ;;
    *) warn "the configuration repo must be an HTTPS git URL: $repo"; return 2 ;;
  esac
  mkdir -p "$(dirname "$repo_file")" && printf '%s' "$repo" > "$repo_file" && chmod 644 "$repo_file"
  if [ -z "$repo" ]; then
    unlink_config
    rm -rf "$config_dir"
    return 0
  fi
  sync_clone >/dev/null || return 1
  link_config
}

# Replaces portable's block in /etc/sandbox-persistent.sh with the `export AWS_...` lines on stdin
# (only names starting with AWS_ are taken). sbx reads that file into every new session, so fresh
# STS credentials reach the next `portable` without recreating the sandbox. Other content stays.
cmd_aws() {
  local lines line name begin='# portable-aws begin' end='# portable-aws end' tmp
  lines=""
  while IFS= read -r line; do
    name="${line#export }"; name="${name%%=*}"
    case "$name" in AWS_[A-Z_]*) lines="$lines$line"$'\n' ;; esac
  done
  tmp="$(mktemp)"
  { [ -f "$persistent" ] && awk -v b="$begin" -v e="$end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$persistent"
    if [ -n "$lines" ]; then printf '%s\n%s%s\n' "$begin" "$lines" "$end"; fi
  } > "$tmp"
  install -m 644 "$tmp" "$persistent" && rm -f "$tmp"
}

# Writes the ports portable forwards to the Mac (`SANDBOX MAC` per line on stdin) to
# /etc/portable/ports, which the start skill and CLAUDE.md read to give the user Mac URLs. Only
# pairs of numbers are taken; the whole file is replaced, so a port that's gone disappears.
cmd_ports() {
  local sandbox mac tmp
  tmp="$(mktemp)"
  {
    echo "# Ports forwarded to the Mac by portable: sandbox port, then the Mac port (http://localhost:<Mac port>)."
    echo "# Rewritten by portable within seconds of a container publishing or dropping a port."
    while read -r sandbox mac; do
      case "$sandbox:$mac" in *[!0-9:]* | :* | *:) continue ;; esac
      echo "$sandbox $mac"
    done
  } > "$tmp"
  mkdir -p /etc/portable && install -m 644 "$tmp" /etc/portable/ports && rm -f "$tmp"
}

# --- doctor ---------------------------------------------------------------------------------------
# The sandbox half of `portable doctor` (lib/doctor.mjs runs the host half and the port-forwarding
# check, then this as the agent in a throwaway sandbox). Prints one line per check; read-only.

ok()   { printf '  ok    %s\n' "$*"; }
note() { printf '  warn  %s\n' "$*"; }
skip() { printf '  skip  %s\n' "$*"; }
fail() { printf '  FAIL  %s\n' "$*"; failed=1; }

# Exit status of an HTTPS request: 0 when the host answered at all, whatever the HTTP status.
# The proxy decrypts HTTPS, so a blocked host still answers: with a 403 page pointing at
# `sbx policy approval`. Only a reply without it means the host was let through.
reachable() {
  local body
  body="$(curl -s --max-time 8 "https://$1" 2>/dev/null)" || return 1
  ! grep -q 'sbx policy' <<< "$body"
}

check_sandbox() {
  echo "Sandbox (the microVM)"
  if [ "$(id -un)" = agent ]; then ok "runs as the ordinary user agent"
  else fail "runs as $(id -un) instead of the ordinary user agent"; fi
  if grep -qs '^flags.*hypervisor' /proc/cpuinfo || [ -d /sys/firmware/qemu_fw_cfg ] || grep -qsi 'virtual\|kvm\|qemu' /sys/class/dmi/id/product_name; then
    ok "runs in a virtual machine with its own kernel ($(uname -r))"
  else
    note "couldn't confirm a virtual machine (kernel $(uname -r)); sbx always uses one, so this is informational"
  fi
  if [ -S /var/run/docker.sock ] && [ "$(docker info --format '{{.Name}}' 2>/dev/null)" != "$(uname -n)" ]; then
    note "a Docker socket is present; check that it's the sandbox's own engine (Docker below)"
  fi

  local probe
  if ! mountpoint -q "$WORKSPACE_DIR" 2>/dev/null && ! grep -qs " $WORKSPACE_DIR " /proc/mounts; then
    fail "your workspace folder isn't shared with the sandbox at $WORKSPACE_DIR"
  elif probe="$(mktemp -p "$WORKSPACE_DIR" .portable-doctor.XXXXXX 2>/dev/null)"; then
    rm -f "$probe"
    ok "sees your workspace folder $WORKSPACE_DIR and can edit files in it"
  else
    fail "can see your workspace folder $WORKSPACE_DIR but can't edit files in it"
  fi
  local parent
  parent="$(dirname "$WORKSPACE_DIR")"
  if [ "$(ls -A "$parent" 2>/dev/null)" = "$(basename "$WORKSPACE_DIR")" ]; then
    ok "sees nothing else on your computer (the folders above are only the path to it)"
  else
    fail "can see other folders next to $WORKSPACE_DIR: $(ls -A "$parent" 2>/dev/null | tr '\n' ' ')"
  fi
}

check_secrets() {
  echo "Credentials"
  # The proxy holds the real values; the sandbox should only see placeholders.
  local leak
  leak="$(env | grep -E '(sk-ant-(api|oat)[0-9]*-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})' | grep -v proxy-managed | cut -d= -f1)"
  if [ -n "$leak" ]; then fail "a real token is readable in the sandbox's environment: $leak"
  else ok "no real Claude or GitHub token is in the sandbox's environment (the proxy adds them)"; fi
  if [ -z "${GH_TOKEN:-}" ]; then
    fail "GitHub: no token was bound (store one with 'portable secret set GH_TOKEN', then recreate the sandbox)"
  elif [ -f /etc/gitconfig ] && grep -q 'gh auth git-credential' /etc/gitconfig; then
    ok "GitHub token is bound (GH_TOKEN is a placeholder) and git uses it through gh"
  else
    fail "GitHub token is bound but git isn't set up to use it (portable-setup install didn't run?)"
  fi
}

check_tools() {
  echo "Tools"
  local tool version
  for tool in claude git gh aws terraform node npm pnpm docker compose; do
    case "$tool" in
      claude) version="$(claude --version 2>/dev/null)" ;;
      git) version="$(git --version 2>/dev/null)" ;;
      gh) version="$(gh --version 2>/dev/null | head -1)" ;;
      aws) version="$(aws --version 2>/dev/null | cut -d' ' -f1)" ;;
      terraform) version="$(terraform version 2>/dev/null | head -1)" ;;
      node) version="$(node --version 2>/dev/null)" && version="node $version" ;;
      npm) version="$(npm --version 2>/dev/null)" && version="npm $version" ;;
      pnpm) version="$(pnpm --version 2>/dev/null)" && version="pnpm $version" ;;
      docker) version="$(docker --version 2>/dev/null)" ;;
      compose) version="$(docker compose version 2>/dev/null)" ;;
    esac
    if [ -n "$version" ]; then ok "$version"; else fail "$tool doesn't run"; fi
  done
}

check_claude_config() {
  echo "Claude configuration"
  local dir=$config_dir name
  if [ -z "$(config_repo)" ]; then
    skip "no Claude configuration repo set (on the environment's page, or claudeConfigRepo in portable's config.json)"
  elif [ ! -d "$dir/.git" ]; then
    fail "your Claude configuration repo couldn't be downloaded (does the GitHub token include it?)"
  elif [ "$(readlink "$state_dir/CLAUDE.md" 2>/dev/null)" != "$dir/global/CLAUDE.md" ]; then
    fail "your Claude configuration repo was downloaded but not installed (its install.sh didn't link CLAUDE.md)"
  else
    ok "your skills, rules and CLAUDE.md are installed (last change $(git -C "$dir" log -1 --format='%cr'))"
    local behind
    behind="$(timeout 20 git -C "$dir" fetch --quiet 2>/dev/null; git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null)"
    if [ "${behind:-0}" -gt 0 ]; then
      note "your Claude configuration is $behind commit(s) behind GitHub; it updates at the next sandbox boot"
    fi
    if [ -w "$dir" ] || [ -w "$dir/global/CLAUDE.md" ]; then
      fail "your Claude configuration's copy can be edited from in here, so a session's edits could block updates"
    else
      ok "your Claude configuration's copy is read-only in here (changes go through GitHub)"
    fi
    for name in $(disabled_names); do
      grep -q "\`$name\`" "$dir/global/CLAUDE.md" "$dir"/rules/*.md 2>/dev/null \
        && fail "your CLAUDE.md or rules still tell Claude to use $name, which this environment turns off"
    done
  fi

  local skill missing=""
  for skill in start stop ui; do
    [ -r "/etc/claude-code/.claude/skills/$skill/SKILL.md" ] || missing="$missing /$skill"
  done
  if [ -z "$missing" ]; then ok "portable's own skills (/start, /stop, /ui) and managed CLAUDE.md are installed"
  else fail "portable's own skills are missing or unreadable:$missing"; fi
  [ -r /etc/claude-code/CLAUDE.md ] || fail "portable's managed CLAUDE.md is missing"

  local settings="$state_dir/settings.json"
  if [ ! -f "$settings" ]; then
    skip "no Claude settings file in the sandbox"
  elif ! jq empty "$settings" 2>/dev/null; then
    fail "the sandbox's Claude settings are broken (settings.json isn't valid JSON)"
  elif jq -e '[.. | strings] | any(test("(^|[^A-Za-z0-9_.-])(/Users|/opt/homebrew|/Applications)(/|$)"))' "$settings" >/dev/null 2>&1; then
    fail "the Claude settings still mention macOS-only paths, which don't exist in here"
  elif [ "$(jq -r '.permissions.defaultMode? // empty' "$settings")" = bypassPermissions ]; then
    fail "Claude starts in bypass mode by default (permissions.defaultMode in $settings); portable-setup update sets it back"
  else
    ok "Claude settings are valid, carry no macOS-only paths and don't start in bypass mode"
  fi
}

check_access() {
  echo "Access"
  local reply login arn
  if reply="$(timeout 90 claude -p "Reply with just the word: ok" 2>&1)" && grep -qi '\bok\b' <<< "$reply"; then
    ok "Claude answered a test prompt (signed in through the proxy)"
  else
    fail "Claude didn't answer a test prompt: $(tail -1 <<< "$reply"). Run 'portable claude' and /login once on this computer"
  fi

  if [ -z "${GH_TOKEN:-}" ]; then
    skip "GitHub: no token bound (see Credentials)"
  elif login="$(timeout 20 gh api user -q .login 2>/dev/null)"; then
    ok "GitHub accepts your token (signed in as $login)"
    local repo
    repo="$(config_repo)"
    if [ -n "$repo" ]; then
      if timeout 20 git ls-remote "$repo" HEAD >/dev/null 2>&1; then
        ok "git can download from GitHub with your token"
      else
        fail "git can't download $repo; add that repo to your token's repository access"
      fi
    fi
  else
    fail "GitHub rejected your token (expired or revoked?)"
  fi
  local name email
  name="$(git config --global --get user.name 2>/dev/null)"; email="$(git config --global --get user.email 2>/dev/null)"
  if [ -n "$name" ] && [ -n "$email" ]; then ok "commits will be made as $name <$email>"
  else note "commits have no name or email; set user.name and user.email in your computer's git config"; fi

  if [ -z "${AWS_ACCESS_KEY_ID:-}" ]; then
    skip "AWS: not turned on for this environment (its page has an AWS section), or signing in failed"
  elif arn="$(timeout 30 aws sts get-caller-identity --query Arn --output text 2>/dev/null)"; then
    ok "AWS accepts your credentials, as $arn (region ${AWS_REGION:-not set})"
  else
    fail "AWS rejected your credentials, or couldn't be reached"
  fi
}

check_docker() {
  echo "Docker (the sandbox's own engine)"
  if ! docker info >/dev/null 2>&1; then
    fail "docker can't reach the sandbox's engine"
    return
  fi
  ok "docker talks to the sandbox's engine (Docker $(docker version --format '{{.Server.Version}}' 2>/dev/null))"
  if ! timeout 120 docker pull -q "$test_image" >/dev/null 2>&1; then
    fail "the engine can't download images from Docker Hub (tried $test_image)"
    return
  fi
  ok "the engine can download images from Docker Hub"
  engine_ok=1

  local probe
  if probe="$(mktemp -p "$WORKSPACE_DIR" .portable-doctor.XXXXXX 2>/dev/null)" \
    && echo portable > "$probe" \
    && [ "$(docker run --rm -v "$WORKSPACE_DIR:/w:ro" "$test_image" cat "/w/${probe##*/}" 2>/dev/null)" = portable ]; then
    ok "containers it starts can use files from your workspace folder"
  else
    fail "containers it starts can't see your workspace folder at $WORKSPACE_DIR"
  fi
  rm -f "$probe"
  if [ "$(docker run --rm -v "$(dirname "$WORKSPACE_DIR"):/p:ro" "$test_image" ls -A /p 2>/dev/null)" = "$(basename "$WORKSPACE_DIR")" ]; then
    ok "containers it starts can't see anything on your computer outside $WORKSPACE_DIR"
  else
    fail "containers it starts can see folders next to $WORKSPACE_DIR"
  fi
}

check_network() {
  echo "Network (the proxy on your computer)"
  local host
  for host in registry.npmjs.org registry.terraform.io; do
    if reachable "$host"; then ok "lets through sites on its list, e.g. $host"
    else fail "blocks $host, which should be allowed"; fi
  done
  if reachable example.com; then fail "lets through sites that aren't on its list (example.com was reachable)"
  else ok "blocks every other site (tested with example.com)"; fi

  if [ -z "$engine_ok" ]; then
    skip "containers Docker starts: not tested, since the engine isn't working (see Docker above)"
    return
  fi
  if docker run --rm "$test_image" wget -q -T 8 -O /dev/null https://registry.npmjs.org 2>/dev/null; then
    ok "containers Docker starts reach sites on its list too"
  else
    fail "containers Docker starts can't reach registry.npmjs.org, which should be allowed"
  fi
  if docker run --rm "$test_image" wget -q -T 8 -O /dev/null https://example.com 2>/dev/null; then
    fail "containers Docker starts can reach sites that aren't on its list (example.com)"
  else
    ok "containers Docker starts are blocked from every other site too"
  fi
}

# Exits non-zero if any check failed. The variables are seen by the check_ functions it calls.
cmd_doctor() {
  local failed=0 test_image=alpine:3 engine_ok=""
  check_sandbox
  check_secrets
  check_tools
  check_claude_config
  check_access
  check_docker
  check_network
  return "$failed"
}

case "${1:-}" in
  install) cmd_install ;;
  update) cmd_update ;;
  config) cmd_config ;;
  aws) cmd_aws ;;
  ports) cmd_ports ;;
  repo) cmd_repo ;;
  doctor) cmd_doctor ;;
  *) echo "usage: portable-setup install|update|config|aws|ports|repo|doctor" >&2; exit 2 ;;
esac
