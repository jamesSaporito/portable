#!/usr/bin/env bash
# Runs inside the sandbox (installed by the kit overlay as /usr/local/bin/portable-setup).
#
#   portable-setup install    lifecycle install hook, as root, once when the sandbox is created:
#                             clones PORTABLE_CLAUDE_CONFIG_REPO, links it into ~/.claude with the
#                             repo's own install.sh, and points git at gh for GitHub credentials
#   portable-setup update     lifecycle startup hook, as root, at every boot: fetches the repo and,
#                             when GitHub has new commits, resets the clone to them and relinks
#   portable-setup settings   from bin/portable through `sbx exec`, as the agent, with the Mac's
#                             ~/.claude/settings.json on stdin: merges it into the sandbox's
#   portable-setup aws        from bin/portable through `sbx exec`, as root, with `export AWS_...`
#                             lines on stdin: makes them the sandbox's AWS credentials
#   portable-setup ports      from bin/portable through `sbx exec`, as root, with `SANDBOX MAC` port
#                             pairs on stdin: records where ports are reachable on the Mac
#
# The clone is root's and read-only to the agent, so a session can't edit it and leave changes that
# block later updates: changes go through the repo on GitHub (see claude-instructions.md). Failures
# with the repo only warn, so the sandbox still works without it.
set -uo pipefail

agent_user=agent
agent_home="${PORTABLE_AGENT_HOME:-/home/$agent_user}"
config_dir=$agent_home/claude-configuration
state_dir=$agent_home/.claude
persistent="${PORTABLE_PERSISTENT_FILE:-/etc/sandbox-persistent.sh}"

warn() { echo "portable: $*" >&2; }

# git on the clone as root, with root's HOME, so gh (the credential helper) keeps its files out of
# the agent's home. Hooks only see the env vars the kit declares, so GH_TOKEN is passed on explicitly.
config_git() { HOME=/root GH_TOKEN="${GH_TOKEN:-}" git -C "$config_dir" "$@"; }

# Prints a CLAUDE.md or rules file (path relative to the clone, read from stdin) without the lines that
# name one of the skills or rules in $2, e.g. the docker-ports workflow step and rule bullet, and with
# CLAUDE.md's numbered list renumbered. This is how the sandbox's copy leaves disabled ones out.
filter_disabled() {
  local name script=""
  for name in $2; do script="$script/\`$name\`/d;"; done
  if [ "$1" = CLAUDE.md ]; then
    sed "$script" | awk '/^[0-9]+\. / { sub(/^[0-9]+/, ++n) } !/^[0-9]+\. / { n = 0 } 1'
  else
    sed "$script"
  fi
}

# Copies files changed or added in the clone, other than by portable's filtering, to the agent's
# backups before an update replaces them. Read-only clones shouldn't have any; just in case.
save_leftovers() {
  local filtered file files="" backup
  filtered="$(cat "$config_dir/.git/portable-filtered" 2>/dev/null)"
  while IFS= read -r file; do
    case "$file" in
      CLAUDE.md | rules/*.md)
        config_git show "HEAD:$file" 2>/dev/null | filter_disabled "$file" "$filtered" \
          | cmp -s - "$config_dir/$file" && continue ;;
    esac
    files="$files$file"$'\n'
  done < <(config_git ls-files --modified --others --exclude-standard)
  [ -n "$files" ] || return 0

  backup="$state_dir/backups/claude-configuration-leftovers/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$backup"
  while IFS= read -r file; do
    (cd "$config_dir" && cp --parents "$file" "$backup" 2>/dev/null)
  done <<< "${files%$'\n'}"
  chown -R "$agent_user:$agent_user" "$state_dir/backups"
  warn "$config_dir had changes made in it, which this update replaces. Saved them to $backup:"
  printf '%s' "$files" | sed 's/^/  /' >&2
}

# Clones or updates the configuration repo (as root). Prints "changed" when files were replaced.
sync_clone() {
  local repo="${PORTABLE_CLAUDE_CONFIG_REPO:-}" disabled="${PORTABLE_CLAUDE_CONFIG_DISABLE:-}"
  local marker="$config_dir/.git/portable-filtered" refilter=""
  [ -n "$repo" ] || return 1

  if [ ! -d "$config_dir/.git" ]; then
    warn "cloning $repo"
    rm -rf "$config_dir"
    if ! HOME=/root GH_TOKEN="${GH_TOKEN:-}" git clone --quiet "$repo" "$config_dir" >&2; then
      warn "couldn't clone $repo (is a GitHub token stored, and does it include this repo?); continuing without it"
      return 1
    fi
    refilter=1
  elif ! HOME=/root GH_TOKEN="${GH_TOKEN:-}" timeout 20 git -C "$config_dir" fetch --quiet >/dev/null 2>&1; then
    warn "couldn't update $config_dir (offline?); using the copy already there"
  elif [ "$(config_git rev-parse HEAD)" != "$(config_git rev-parse '@{u}')" ]; then
    # Only touch the files when there's something new, so sessions already running never see them
    # half-updated. A reset rather than a merge: the clone only ever mirrors the remote.
    save_leftovers
    config_git reset --quiet --hard '@{u}' && config_git clean -fdq
    refilter=1
  fi
  if [ "$(cat "$marker" 2>/dev/null)" != "$disabled" ]; then
    config_git checkout --quiet -- CLAUDE.md rules 2>/dev/null
    refilter=1
  fi

  if [ -n "$refilter" ]; then
    # Edits go to the clone's files, which ~/.claude links to, so the links stay intact.
    local path
    for path in "$config_dir/CLAUDE.md" "$config_dir"/rules/*.md; do
      [ -f "$path" ] || continue
      filter_disabled "${path#"$config_dir/"}" "$disabled" < "$path" > "$path.tmp" && mv "$path.tmp" "$path"
    done
    echo "$disabled" > "$marker"
  fi
  chown -R root:root "$config_dir"
  chmod -R a+rX,go-w "$config_dir"
  [ -n "$refilter" ] && echo changed
  return 0
}

# Links the clone into ~/.claude with the repo's own install.sh, as the agent. install.sh keeps
# disabled names in personal-disabled, written from the env var so names removed from .env come
# back on. CLAUDE_CONFIGURATION_DIR makes it treat this clone as the installed copy.
link_config() {
  [ -d "$config_dir/.git" ] || return 0
  local name
  mkdir -p "$state_dir"
  for name in ${PORTABLE_CLAUDE_CONFIG_DISABLE:-}; do echo "$name"; done > "$state_dir/personal-disabled"
  chown "$agent_user:$agent_user" "$state_dir" "$state_dir/personal-disabled"
  runuser -u "$agent_user" -- env HOME="$agent_home" CLAUDE_CONFIG_DIR="$state_dir" \
      CLAUDE_CONFIGURATION_DIR="$config_dir" bash "$config_dir/install.sh" 2>&1 \
    | grep -v '^Already up to date' >&2 || true
}

cmd_install() {
  # git over HTTPS to GitHub gets its credentials from gh, which reads GH_TOKEN (the proxy-managed
  # placeholder; the proxy swaps in the real token). Same wiring as Docker's github-clone kit.
  git config --system credential.https://github.com.helper '!gh auth git-credential'
  git config --system credential.https://gist.github.com.helper '!gh auth git-credential'
  git config --system --add safe.directory "$config_dir"
  if [ -z "${PORTABLE_CLAUDE_CONFIG_REPO:-}" ]; then
    warn "no Claude configuration repo set (PORTABLE_CLAUDE_CONFIG_REPO); skipping"
    return 0
  fi
  sync_clone >/dev/null && link_config
}

cmd_update() {
  [ -n "${PORTABLE_CLAUDE_CONFIG_REPO:-}" ] || return 0
  local result
  result="$(sync_clone)" || return 0
  # Relink when files changed, or when the install never happened (e.g. the repo was unreachable then).
  if [ "$result" = changed ] || [ "$(readlink "$state_dir/CLAUDE.md" 2>/dev/null)" != "$config_dir/CLAUDE.md" ]; then
    link_config
  fi
}

# Merges the Mac's ~/.claude/settings.json (on stdin) into the sandbox's, Mac values winning, except:
#   - settings that run Mac commands or hold Mac-only auth (hooks, status line, credential helpers,
#     Anthropic env overrides), dropped whole; the sandbox's own values for those stay, since Docker's
#     Claude workload relies on them for proxy-managed sign-in
#   - any other value mentioning a macOS path (/Users/..., /opt/homebrew/..., etc.), wherever it is,
#     e.g. a permission rule or an additionalDirectories entry. Paths inside the workspace are kept,
#     since it's mounted at the same path in here.
cmd_settings() {
  local file="$state_dir/settings.json" host tmp
  host="$(cat)"
  [ -n "$host" ] || return 0
  [ -s "$file" ] || echo '{}' > "$file"
  tmp="$(mktemp)"
  if jq --argjson host "$host" --arg ws "${WORKSPACE_DIR:-/nonexistent}" '
      def host_path: type == "string"
        and test("(^|[^A-Za-z0-9_.-])(/Users|/Applications|/Library|/System|/Volumes|/private|/opt/homebrew)(/|$)")
        and (contains($ws) | not);
      ($host
        | del(.hooks, .statusLine, .apiKeyHelper, .awsAuthRefresh, .awsCredentialExport, .otelHeadersHelper)
        | del(.env.ANTHROPIC_API_KEY, .env.ANTHROPIC_AUTH_TOKEN, .env.ANTHROPIC_BASE_URL, .env.CLAUDE_CODE_OAUTH_TOKEN)
        | delpaths([paths(host_path)])) as $clean
      | . * $clean' \
      "$file" > "$tmp" 2>/dev/null; then
    if cmp -s "$tmp" "$file"; then rm -f "$tmp"; else mv "$tmp" "$file"; fi
  else
    rm -f "$tmp"
    warn "couldn't merge the Mac's settings.json; keeping the sandbox's"
  fi
}

# Replaces portable's block in /etc/sandbox-persistent.sh with the `export AWS_...` lines on stdin
# (only names starting with AWS_ are taken). sbx reads that file into every new session, so fresh
# STS credentials reach the next `portable` without recreating the sandbox. Other content stays.
cmd_aws() {
  local lines line name begin='# portable-aws begin' end='# portable-aws end' tmp
  lines=""
  while IFS= read -r line; do
    name="${line#export }"; name="${name%%=*}"
    case "$name" in AWS_[A-Z_]*) lines="$lines$line"$'\n' ;; esac
  done
  tmp="$(mktemp)"
  { [ -f "$persistent" ] && awk -v b="$begin" -v e="$end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$persistent"
    if [ -n "$lines" ]; then printf '%s\n%s%s\n' "$begin" "$lines" "$end"; fi
  } > "$tmp"
  install -m 644 "$tmp" "$persistent" && rm -f "$tmp"
}

# Writes the ports portable forwards to the Mac (`SANDBOX MAC` per line on stdin) to
# /etc/portable/ports, which the start skill and CLAUDE.md read to give the user Mac URLs. Only
# pairs of numbers are taken; the whole file is replaced, so a port that's gone disappears.
cmd_ports() {
  local sandbox mac tmp
  tmp="$(mktemp)"
  {
    echo "# Ports forwarded to the Mac by portable: sandbox port, then the Mac port (http://localhost:<Mac port>)."
    echo "# Rewritten by portable within seconds of a container publishing or dropping a port."
    while read -r sandbox mac; do
      case "$sandbox:$mac" in *[!0-9:]* | :* | *:) continue ;; esac
      echo "$sandbox $mac"
    done
  } > "$tmp"
  mkdir -p /etc/portable && install -m 644 "$tmp" /etc/portable/ports && rm -f "$tmp"
}

case "${1:-}" in
  install) cmd_install ;;
  update) cmd_update ;;
  settings) cmd_settings ;;
  aws) cmd_aws ;;
  ports) cmd_ports ;;
  *) echo "usage: portable-setup install|update|settings|aws|ports" >&2; exit 2 ;;
esac
