#!/bin/sh
# The `portable` command install.sh links onto PATH. Runs bin/portable.mjs with portable's own
# Node 26 (~/.local/share/portable-node, installed by install.sh), so every computer runs portable
# on the same Node line whatever else is installed. Falls back to the `node` on PATH when that's
# missing, e.g. in a clone before install.sh has run.
set -e

# Resolve symlinks so this works when linked onto PATH.
src="$0"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root="$(cd -P "$(dirname "$src")/.." && pwd)"

node="${PORTABLE_NODE_DIR:-$HOME/.local/share/portable-node}/current/bin/node"
[ -x "$node" ] || node="$(command -v node || true)"
if [ -z "$node" ]; then
  echo "portable: Node isn't installed; run $root/install.sh, which installs portable's own Node 26" >&2
  exit 1
fi
exec "$node" "$root/bin/portable.mjs" "$@"
