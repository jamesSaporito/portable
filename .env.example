# Copy to .env to change settings. No secrets here; those go in the Keychain via `portable secret set`.

# Host folder the container can see, mounted at the same path inside it. Nothing else on the host is visible.
WORKSPACE_DIR=~/Projects/sandboxed

# Git identity for commits made in the container. Defaults to your host's `git config --global user.name/email`.
# GIT_NAME=
# GIT_EMAIL=

# Host AWS profile whose temporary credentials are passed in (SSO or assumed role). Leave unset for no AWS access.
# PORTABLE_AWS_PROFILE=default

# Personal Claude configuration (skills, rules, CLAUDE.md), cloned on first start and linked into ~/.claude
# by its install.sh. Needs GH_TOKEN to cover the repo if it's private. Leave unset to skip.
PORTABLE_CLAUDE_CONFIG_REPO=https://github.com/jamesSaporito/claude-configuration.git
# Space-separated skills/rules to turn off in the container, e.g. ones that only work on the Mac.
# PORTABLE_CLAUDE_CONFIG_DISABLE=

# Model Claude starts with in the container (default opus, as on a Pro/Max login); /model still switches.
# ANTHROPIC_DEFAULT_MODEL=sonnet

# Outbound firewall (on by default): only Claude, GitHub, npm, Terraform and AWS (your region, without
# EC2, CloudFront, API Gateway or Global Accelerator) are reachable. Add hosts a project needs,
# space-separated, or set PORTABLE_FIREWALL=off. Some AWS APIs share EC2's addresses and need listing
# here, e.g. lambda.us-east-1.amazonaws.com secretsmanager.us-east-1.amazonaws.com
# PORTABLE_ALLOW_DOMAINS=pypi.org files.pythonhosted.org
# PORTABLE_FIREWALL=off

# Ports of projects running in portable to open on your Mac, at 127.0.0.1 with the same numbers,
# space-separated. The engine publishes them all the time, so while portable runs the Mac can't use
# them for anything else (e.g. the same project run on the Mac), and the engine won't start if one is taken.
# PORTABLE_PORTS=3000 5432
