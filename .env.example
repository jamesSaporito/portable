# install.sh copies this to ~/.config/portable/.env, the settings every copy of portable reads.
# No secrets here; the GitHub token goes in the Keychain via `portable secret set GH_TOKEN`, and
# Claude's sign-in is done once per Mac with /login inside `portable claude`.

# The most a sandbox can see, e.g. all your projects. Each session mounts only the folder `portable` is run in,
# which must be this one or a folder inside it, at the same path. Nothing else on the Mac is visible.
WORKSPACE_DIR=~/Projects/sandboxed

# Host AWS profile whose temporary credentials are passed in (SSO or assumed role). Leave unset for no AWS access.
# PORTABLE_AWS_PROFILE=default

# Personal Claude configuration (skills, rules, CLAUDE.md), cloned when a sandbox is created and linked into
# ~/.claude by its install.sh; updated at every boot. Needs GH_TOKEN to cover the repo if it's private.
PORTABLE_CLAUDE_CONFIG_REPO=
# Space-separated skills/rules to turn off in the sandbox, e.g. ones that only work on the Mac.
# PORTABLE_CLAUDE_CONFIG_DISABLE=

# Hosts a project may reach besides the kit's list (GitHub, npm, Terraform, Docker Hub, the Alpine and
# Debian mirrors, AWS), by name, space-separated. Applied to this Mac's sbx policy at each start.
# PORTABLE_ALLOW_DOMAINS=pypi.org files.pythonhosted.org
